 impl PipelineCacheInterface for Inert {
     fn get_data(&self) -> Option<Vec<u8>> { None }
+}
+
+pub(crate) fn no_blit() -> bool {
+    static F: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *F.get_or_init(|| std::env::var_os("RUNE_NOBLIT").is_some())
+}
+
+pub(super) fn cpu_zero_texture(texture: &TextureRaw) {
+    let Some(block) = texture.format.block_copy_size(None) else { return };
+    let (bw, bh) = texture.format.block_dimensions();
+    let three = texture.dimension == wgpu::TextureDimension::D3;
+    let raw = &texture.raw;
+    for mip in 0..texture.mips as usize {
+        let (w, h) = ((raw.width() >> mip).max(1), (raw.height() >> mip).max(1));
+        let row = w.div_ceil(bw as usize) * block as usize;
+        let rows = h.div_ceil(bh as usize);
+        let zeros = vec![0u8; row * rows];
+        let slices = if three { (raw.depth() >> mip).max(1) } else { texture.layers as usize };
+        for s in 0..slices {
+            let (slice, z) = if three { (0, s) } else { (s, 0) };
+            let region = objc2_metal::MTLRegion { origin: MTLOrigin { x: 0, y: 0, z }, size: MTLSize { width: w, height: h, depth: 1 } };
+            unsafe { raw.replaceRegion_mipmapLevel_slice_withBytes_bytesPerRow_bytesPerImage(region, mip, slice, std::ptr::NonNull::new_unchecked(zeros.as_ptr() as *mut _), row, 0) }
+        }
+    }
+}
+
+pub(super) fn cpu_to_texture(base: *const u8, layout: wgpu::TexelCopyBufferLayout, texture: &TextureRaw, mip: u32, at: wgpu::Origin3d, size: wgpu::Extent3d) {
+    let (row, image) = strides(texture.format, layout, size);
+    for (slice, z, depth, i) in layers(texture, at, size) {
+        let per_image = if depth > 1 { image } else { 0 };
+        let region = objc2_metal::MTLRegion { origin: origin(at, z), size: extent(size.width, size.height, depth) };
+        unsafe {
+            let p = base.add(layout.offset as usize + image * i) as *mut std::ffi::c_void;
+            texture.raw.replaceRegion_mipmapLevel_slice_withBytes_bytesPerRow_bytesPerImage(region, mip as usize, slice, std::ptr::NonNull::new_unchecked(p), row, per_image)
+        }
+    }
 }
